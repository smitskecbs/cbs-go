{
  "name": "cbs-go",
  "private": true,
  "type": "module",
  "homepage": "https://smitskecbs.github.io/cbs-go/",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web",
    "build:web": "node scripts/sync-version-json.mjs && cross-env BUILD_TARGET=web vite build",
    "build:web:gh-pages": "cross-env BUILD_TARGET=web VITE_BASE_PATH=/cbs-go/ vite build",
    "build:android": "cross-env BUILD_TARGET=android vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^7.6.0",
    "@capacitor/core": "^8.2.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.98.0",
    "bs58": "^6.0.0",
    "maplibre-gl": "^5.18.0",
    "tweetnacl": "^1.0.3"
  }
}
